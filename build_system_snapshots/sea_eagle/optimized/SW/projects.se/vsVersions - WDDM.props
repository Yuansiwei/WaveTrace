<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <!-- Current default VS 2019 - version 16.0 -->
    <PlatformToolset>v142</PlatformToolset>
    <!-- VS 2022 - version 17.0 -->
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <!-- VS 2019 - version 16.0 -->
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '16.0'">v142</PlatformToolset>
    <!-- Visual Studio 2017 - version 15.0 -->
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '15.0'">v141</PlatformToolset>
    <!-- Visual Studio 2015 - version 14.0 -->
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '14.0'">v140</PlatformToolset>
    <!-- Visual Studio 2013 - version 12.0 -->
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '12.0'">v120</PlatformToolset>
    <!-- Visual Studio 2012 - version 11.0 -->
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '11.0'">v110</PlatformToolset>
  </PropertyGroup>

  <PropertyGroup Label="UserMacros">
    <PROJECT_DEV>$([MSBUILD]::GetDirectoryNameOfFileAbove('$(SolutionDir)', 'CreateLinks.bat'))</PROJECT_DEV>
    <VIVANTE_SDK_DIR>$(PROJECT_DEV)\build\$(PlatformTarget)</VIVANTE_SDK_DIR>
    <PATH>$(PATH);$(VIVANTE_SDK_DIR)\bin</PATH>
    <TLogLocation>$(SolutionDir)output\$(Configuration)\$(ProjectName)\$(ProjectName).tlog\$(PlatformTarget)\</TLogLocation>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- These warnings were taken from the current VS 2012 disabled warnigns from all projects -->
      <GlobalDisabledWarnings>4054;4055;4201;4244;4267;4305;4306;4701;4711;4819;4820;4996</GlobalDisabledWarnings>
      <!-- These warnings are new for VS 2019 -->
      <GlobalDisabledWarnings>4005;4456;4473;4474;4477;%(GlobalDisabledWarnings)</GlobalDisabledWarnings>
      <!-- These warnings are new after enabling Level 4 warnings -->
      <GlobalDisabledWarnings>4065;4100;4189;4457;4459;4505;4702;4703;%(GlobalDisabledWarnings)</GlobalDisabledWarnings>
      <DisableSpecificWarnings>%(GlobalDisabledWarnings)</DisableSpecificWarnings>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
  </ItemDefinitionGroup>

<!-- 
  <ItemGroup>
    <BuildMacro Include="PROJECT_DEV">
      <Value>$(PROJECT_DEV)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
    <BuildMacro Include="VIVANTE_SDK_DIR">
      <Value>$(VIVANTE_SDK_DIR)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
  </ItemGroup>
-->

</Project>

