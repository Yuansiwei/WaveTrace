

macro(match_key str key val)
    string(REGEX MATCH "${key}=([^\r\n]*)" notCare "${str}")
    set(${val} ${CMAKE_MATCH_1})
    #message(STATUS "${val} ${CMAKE_MATCH_1}")
endmacro()

macro(map_key key0 key1 val)
    set(${key0}_${key1} ${val})
    #message(STATUS "key[${key0}_${key1}] = ${val}")
endmacro()

function (ADD_DUMP_DIR dir incDir libDir)
    set(LIBRARIES ${ARGN})
    file(GLOB cases ${dir}/[0-9]*-[0-9]*-[0-9]*-[0-9]*\.txt)

    foreach(case IN LISTS cases)
        cmake_path(GET case PARENT_PATH CASE_path)
        cmake_path(GET case FILENAME filename)
        cmake_path(GET filename STEM LAST_ONLY name)
        string(REGEX REPLACE ".txt$" ".spv" CASE_spv ${filename})
        string(REGEX MATCH "([0-9]*-[0-9]*-[0-9]*-[0-9]*)\.txt$" notCare "${filename}")
        set(case_prefix ${CMAKE_MATCH_1})

        file(READ ${case} case_config)
        match_key("${case_config}" "name" CASE_funcname)
        match_key("${case_config}" "gridx" CASE_gridx)
        match_key("${case_config}" "gridy" CASE_gridy)
        match_key("${case_config}" "gridz" CASE_gridz)
        match_key("${case_config}" "blockx" CASE_blockx)
        match_key("${case_config}" "blocky" CASE_blocky)
        match_key("${case_config}" "blockz" CASE_blockz)
        match_key("${case_config}" "sharedSize" CASE_sharedSize)
        match_key("${case_config}" "argCount" CASE_argCount)
        match_key("${case_config}" "resCount" CASE_resCount)
        match_key("${case_config}" "varCount" CASE_varCount)

        # mapping
        set(initArgCount        0)
        set(initGlobalCount     0)
        set(initManagedCount    0)
        set(initVACount         0)

        file(GLOB initArgFiles "${dir}/${case_prefix}-init-arg[0-9]*-[^V]-[0-9]*\.bin")
        foreach(f IN LISTS initArgFiles)
            cmake_path(GET f FILENAME f)
            string(REGEX MATCH "${case_prefix}-init-(arg[0-9]*)-([A-Z])-([0-9]*)\.bin" notCare "${f}")
            map_key("${CMAKE_MATCH_1}" "init" "${f}")
            map_key("${CMAKE_MATCH_1}" "init_flag" "${CMAKE_MATCH_2}")
            map_key("${CMAKE_MATCH_1}" "init_offset" "${CMAKE_MATCH_3}")
            math(EXPR initArgCount "${initArgCount} + 1")
        endforeach()

        file(GLOB initVAFiles "${dir}/${case_prefix}-init-arg[0-9]*-V-[0-9]*\.bin")
        foreach(f IN LISTS initVAFiles)
            cmake_path(GET f FILENAME f)
            string(REGEX MATCH "${case_prefix}-init-(arg[0-9]*)-([A-Z])-([0-9]*)\.bin" notCare "${f}")
            map_key("${CMAKE_MATCH_1}" "VA_init" "${f}")
            map_key("${CMAKE_MATCH_1}" "VA_init_flag" "${CMAKE_MATCH_2}")
            map_key("${CMAKE_MATCH_1}" "VA_init_addr" "${CMAKE_MATCH_3}")
            math(EXPR initVACount "${initVACount} + 1")
        endforeach()

        file(GLOB initGlobalFiles "${dir}/${case_prefix}-init-global[0-9]*-[^.]*\.bin")
        foreach(f IN LISTS initGlobalFiles)
            cmake_path(GET f FILENAME f)
            string(REGEX MATCH "${case_prefix}-init-(global[0-9]*)-([^.]*)\.bin" notCare "${f}")
            map_key("${CMAKE_MATCH_1}" "init" "${f}")
            map_key("${CMAKE_MATCH_1}" "init_var" "${CMAKE_MATCH_2}")
            math(EXPR initGlobalCount "${initGlobalCount} + 1")
        endforeach()

        file(GLOB initManagedFiles "${dir}/${case_prefix}-init-managed[0-9]*-[^.]*\.bin")
        foreach(f IN LISTS initManagedFiles)
            cmake_path(GET f FILENAME f)
            string(REGEX MATCH "${case_prefix}-init-(managed[0-9]*)-([^.]*)\.bin" notCare "${f}")
            map_key("${CMAKE_MATCH_1}" "init" "${f}")
            map_key("${CMAKE_MATCH_1}" "init_var" "${CMAKE_MATCH_2}")
            math(EXPR initManagedCount "${initManagedCount} + 1")
        endforeach()

        file(GLOB verifyArgFiles "${dir}/${case_prefix}-verify-arg[0-9]*-[^V]-[0-9]*\.bin")
        foreach(f IN LISTS verifyArgFiles)
            cmake_path(GET f FILENAME f)
            string(REGEX MATCH "${case_prefix}-verify-(arg[0-9]*)-([A-Z])-([0-9]*)\.bin" notCare "${f}")
            map_key("${CMAKE_MATCH_1}" "verify" "${f}")
            map_key("${CMAKE_MATCH_1}" "verify_flag" "${CMAKE_MATCH_2}")
            map_key("${CMAKE_MATCH_1}" "verify_offset" "${CMAKE_MATCH_3}")
        endforeach()
        file(GLOB verifyVAFiles "${dir}/${case_prefix}-verify-arg[0-9]*-V-[0-9]*\.bin")
        foreach(f IN LISTS verifyVAFiles)
            cmake_path(GET f FILENAME f)
            string(REGEX MATCH "${case_prefix}-verify-(arg[0-9]*)-([A-Z])-([0-9]*)\.bin" notCare "${f}")
            map_key("${CMAKE_MATCH_1}" "VA_verify" "${f}")
            map_key("${CMAKE_MATCH_1}" "VA_verify_flag" "${CMAKE_MATCH_2}")
            map_key("${CMAKE_MATCH_1}" "VA_verify_addr" "${CMAKE_MATCH_3}")
        endforeach()

        file(GLOB verifyGlobalFiles "${dir}/${case_prefix}-verify-global[0-9]*-[^.]*\.bin")
        foreach(f IN LISTS verifyGlobalFiles)
            cmake_path(GET f FILENAME f)
            string(REGEX MATCH "${case_prefix}-verify-(global[0-9]*)-([^.]*)\.bin" notCare "${f}")
            map_key("${CMAKE_MATCH_1}" "verify" "${f}")
            map_key("${CMAKE_MATCH_1}" "verify_var" "${CMAKE_MATCH_2}")
        endforeach()

        file(GLOB verifyManagedFiles "${dir}/${case_prefix}-verify-managed[0-9]*-[^.]*\.bin")
        foreach(f IN LISTS verifyManagedFiles)
            cmake_path(GET f FILENAME f)
            string(REGEX MATCH "${case_prefix}-verify-(managed[0-9]*)-([^.]*)\.bin" notCare "${f}")
            map_key("${CMAKE_MATCH_1}" "verify" "${f}")
            map_key("${CMAKE_MATCH_1}" "verify_var" "${CMAKE_MATCH_2}")
        endforeach()
        # end of mapping
        ############################

        set(CASE_args "")
        if (NOT "${initArgCount}" STREQUAL "0")
            math(EXPR initArgCount "${initArgCount} - 1")
            foreach(idx RANGE ${initArgCount})
                set(arg "        {")
                if (arg${idx}_init)
                    set(arg "${arg} \"${arg${idx}_init}\",")
                endif()
                if (arg${idx}_verify)
                    set(arg "${arg} \"${arg${idx}_verify}\",")
                else()
                    set(arg "${arg} nullptr,")
                endif()
                if (arg${idx}_init_flag)
                    set(arg "${arg} \'${arg${idx}_init_flag}\',")
                endif()
                if (arg${idx}_init_offset)
                    set(arg "${arg} ${arg${idx}_init_offset}ULL,")
                else()
                    set(arg "${arg} 0ULL,")
                endif()
                set(arg "${arg}},\n")
                set(CASE_args   "${CASE_args}${arg}")
            endforeach()
        endif()

        set(CASE_VAs "")
        if (NOT "${initVACount}" STREQUAL "0")
            math(EXPR initVACount "${initVACount} - 1")
            foreach(idx RANGE ${initVACount})
                set(arg "        {")
                if (arg${idx}_VA_init)
                    set(arg "${arg} \"${arg${idx}_VA_init}\",")
                endif()
                if (arg${idx}_VA_verify)
                    set(arg "${arg} \"${arg${idx}_VA_verify}\",")
                else()
                    set(arg "${arg} nullptr,")
                endif()
                if (arg${idx}_VA_init_flag)
                    set(arg "${arg} \'${arg${idx}_VA_init_flag}\',")
                endif()
                if (arg${idx}_VA_init_offset)
                    set(arg "${arg} ${arg${idx}_VA_init_addr}ULL,")
                else()
                    set(arg "${arg} 0ULL,")
                endif()
                set(arg "${arg}},\n")
                set(CASE_VAs   "${CASE_VAs}${arg}")
            endforeach()
        endif()

        set(CASE_globals "")
        if (NOT "${initGlobalCount}" STREQUAL "0")
            math(EXPR initGlobalCount "${initGlobalCount} - 1")
            foreach(idx RANGE ${initGlobalCount})
                set(arg "        {")
                if (global${idx}_init)
                    set(arg "${arg} \"${global${idx}_init}\",")
                endif()
                if (global${idx}_verify)
                    set(arg "${arg} \"${global${idx}_verify}\",")
                else()
                    set(arg "${arg} nullptr,")
                endif()
                if (global${idx}_init_var)
                    set(arg "${arg} \"${global${idx}_init_var}\",")
                endif()
                set(arg "${arg} \'G\',},\n")
                set(CASE_globals   "${CASE_globals}${arg}")
            endforeach()
        endif()
        if (NOT "${initManagedCount}" STREQUAL "0")
            math(EXPR initManagedCount "${initManagedCount} - 1")
            foreach(idx RANGE ${initManagedCount})
                set(arg "        {")
                if (managed${idx}_init)
                    set(arg "${arg} \"${managed${idx}_init}\",")
                endif()
                if (managed${idx}_verify)
                    set(arg "${arg} \"${managed${idx}_verify}\",")
                else()
                    set(arg "${arg} nullptr,")
                endif()
                if (managed${idx}_init_var)
                    set(arg "${arg} \"${managed${idx}_init_var}\",")
                endif()
                set(arg "${arg} \'M\',},\n")
                set(CASE_globals   "${CASE_globals}${arg}")
            endforeach()
        endif()

        #message("args \n${CASE_args}")
        #message("glob \n${CASE_globals}")

        configure_file(${CMAKE_CURRENT_FUNCTION_LIST_DIR}/main.cpp.in ${CMAKE_CURRENT_BINARY_DIR}/${name}.cpp @ONLY)
        add_executable(${name} ${CMAKE_CURRENT_BINARY_DIR}/${name}.cpp)
        target_include_directories(${name} PUBLIC ${incDir})
        target_link_directories(${name} PUBLIC ${libDir})
        target_link_libraries(${name} PUBLIC ${LIBRARIES})
    endforeach()
endfunction()

