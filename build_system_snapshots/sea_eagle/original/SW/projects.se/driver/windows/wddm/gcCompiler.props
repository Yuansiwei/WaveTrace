<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Configuration">
    <Driver_SpectreMitigation>Spectre</Driver_SpectreMitigation>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>NEW_CMODEL_CONSTRUCTOR=1;EMULATOR;AQ2_DMA;XAQ2;VIV_D3D11_SUPPORT=1;VK_LOCAL_TEST=1;__VK_ENABLETS=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(ProjectName)' == 'gcKmd'">DXGKDDI_INTERFACE_VERSION=DXGKDDI_INTERFACE_VERSION_WDDM2_4;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level4</WarningLevel>
      <WarningLevel Condition="'$(ProjectName)' == 'viv_cmodel'">Level3</WarningLevel>
      <ExternalWarningLevel>InheritWarningLevel</ExternalWarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <TreatWarningAsError Condition="'$(ProjectName)' == 'viv_cmodel'">false</TreatWarningAsError>
      <!-- These warnings were taken from the current VS 2012 disabled warnings from all projects -->
      <GlobalDisabledWarnings>4054;4055;4201;4244;4267;4305;4306;4701;4711;4819;4820;4996</GlobalDisabledWarnings>
      <!-- These warnings are new for VS 2019 -->
      <GlobalDisabledWarnings>4005;4456;4473;4474;4477;%(GlobalDisabledWarnings)</GlobalDisabledWarnings>
      <!-- These warnings are new after enabling Level 4 warnings -->
      <GlobalDisabledWarnings>4065;4100;4189;4457;4459;4505;4702;4703;%(GlobalDisabledWarnings)</GlobalDisabledWarnings>
      <GlobalDisabledWarnings Condition="'$(ProjectName)' == 'viv_cmodel'">4334;4018;4244;4197;4700;4715;4702;4701;4242;4603;4627;4986;4987;4996;4748;</GlobalDisabledWarnings>
      <DisableSpecificWarnings>%(GlobalDisabledWarnings)</DisableSpecificWarnings>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>GC_VER_FILEVERSION=$(GC_RC_WDDM_DRIVER_VERSION);GC_VER_FILEVERSION_STR=$(GC_RC_WDDM_DRIVER_VERSION_STR);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>

