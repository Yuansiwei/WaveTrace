<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <WaveTraceRoot Condition="'$(WaveTraceRoot)'==''">$(MSBuildThisFileDirectory)..</WaveTraceRoot>
    <ZstdIncludeDir>$(WaveTraceRoot)\third_party\zstd\include</ZstdIncludeDir>
    <ZstdLibDir>$(WaveTraceRoot)\tools\lib</ZstdLibDir>
    <ZstdLib Condition="'$(Configuration)'=='Debug'">zstd_debug.lib</ZstdLib>
    <ZstdLib Condition="'$(ZstdLib)'==''">zstd_release.lib</ZstdLib>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ZstdIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ZstdLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(ZstdLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="CheckWaveTraceZstdPrebuilt" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(ZstdIncludeDir)\zstd.h')" Text="WaveTrace zstd.h not found: $(ZstdIncludeDir)\zstd.h" />
    <Error Condition="!Exists('$(ZstdLibDir)\$(ZstdLib)')" Text="WaveTrace zstd library not found: $(ZstdLibDir)\$(ZstdLib)" />
  </Target>
</Project>
